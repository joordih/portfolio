PORT=8080
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional locally; on Vercel defaults to CLIENT_ORIGIN/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback
ADMIN_LOGIN=your-github-username

# Database — local dev uses file:./data.db when unset
# LIBSQL_URL=file:./data.db
# LIBSQL_AUTH_TOKEN=

# Vercel production: create a free DB at https://turso.tech and set:
# LIBSQL_URL=libsql://your-db-name-user.turso.io
# LIBSQL_AUTH_TOKEN=your-token